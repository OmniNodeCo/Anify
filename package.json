{
  "name": "anify",
  "version": "1.0.0",
  "type": "module",
  "description": "Anify - AI Character Animation Studio & App",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:web": "vite build",
    "build:app": "vite build && electron-builder --linux --dir",
    "package:app": "vite build && electron-builder --linux zip",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "build": {
    "appId": "ai.arena.anify",
    "productName": "Anify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "zip",
        "dir"
      ],
      "category": "Graphics"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmniNodeCo/Anify.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/OmniNodeCo/Anify/issues"
  },
  "homepage": "https://github.com/OmniNodeCo/Anify#readme",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
